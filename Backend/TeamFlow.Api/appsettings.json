{
  "AppSettings": {
    "BackendUrl": "http://0.0.0.0:5000",
    "FrontendUrl": "http://localhost:5173"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=TeamFlowDb;User Id=your_user;Password=your_password;"
  },
  "JwtSettings": {
    "SecretKey": "your-secret-key-change-this-in-production",
    "Issuer": "TeamFlowAppAuth",
    "Audience": "back-end",
    "ExpiryMinutes": 600
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "your-email@gmail.com",
    "Password": "your-app-password",
    "SenderEmail": "your-email@gmail.com",
    "SenderName": "TeamFlow"
  }
}
